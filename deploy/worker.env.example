# /etc/callai/worker.env  (chmod 600; owner root)
AWS_REGION=ap-south-1
OTR_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/callai-calls
OTR_RESULTS_URL=https://<portal-backend>/api/callai/results
OTR_RESULTS_TOKEN=
OTR_RESULTS_S3=s3://<bucket>/callai-results/
OTR_BATCH=32
OTR_IDLE_STOP_S=180
OTR_LLM_SLOTS=4
OTR_REVIEW_CONF=0.4
